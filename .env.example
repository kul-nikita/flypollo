# Copy this file to .env and fill in real values.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# Then run `netlify dev` — both the Vite frontend and the serverless functions
# will pick these variables up.

# ---------------------------------------------------------------------------
# Server-side only. Used by netlify/functions/* to call the Anthropic API.
# Never prefix with VITE_ and never expose this to the browser.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by netlify/functions/generate-mcq.js.
# Defaults to claude-opus-4-8 when unset.
MODEL_NAME=

# ---------------------------------------------------------------------------
# Firebase web config. Vite only exposes variables prefixed with VITE_ to the
# browser bundle, so the Firebase client uses VITE_FIREBASE_*.
# Copy these values from Firebase console > Project settings > Your apps > SDK
# setup and configuration > Config.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
