rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function normalizeStatus(status) {
      return status == 'ready' ? 'published' :
             (status == 'ended' ? 'completed' : status);
    }

    function validTransition(prevRaw, nextRaw) {
      let prev = normalizeStatus(prevRaw);
      let next = normalizeStatus(nextRaw);
      return (prev == 'draft' && next in ['draft', 'published']) ||
             (prev == 'published' && next in ['published', 'live', 'draft']) ||
             (prev == 'live' && next in ['live', 'completed', 'draft']) ||
             (prev == 'completed' && next in ['completed', 'draft']);
    }

    function isLiveSession(sessionId) {
      let path = /databases/$(database)/documents/sessions/$(sessionId);
      return exists(path) && get(path).data.status == 'live';
    }

    function validEmail(email) {
      return email is string &&
             email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function validQuestion(q) {
      return q is map &&
             q.keys().hasAll(['question', 'options', 'correctIndex']) &&
             q.question is string && q.question.size() > 0 &&
             q.options is list && q.options.size() == 4 &&
             q.options[0] is string && q.options[0].size() > 0 &&
             q.options[1] is string && q.options[1].size() > 0 &&
             q.options[2] is string && q.options[2].size() > 0 &&
             q.options[3] is string && q.options[3].size() > 0 &&
             q.correctIndex is int &&
             q.correctIndex >= 0 && q.correctIndex <= 3;
    }

    // Rules v2 cannot iterate over lists, so each position is checked
    // explicitly up to a safe maximum.
    function validQuestionList(questions) {
      return (questions.size() < 1 || validQuestion(questions[0])) &&
             (questions.size() < 2 || validQuestion(questions[1])) &&
             (questions.size() < 3 || validQuestion(questions[2])) &&
             (questions.size() < 4 || validQuestion(questions[3])) &&
             (questions.size() < 5 || validQuestion(questions[4])) &&
             (questions.size() < 6 || validQuestion(questions[5])) &&
             (questions.size() < 7 || validQuestion(questions[6])) &&
             (questions.size() < 8 || validQuestion(questions[7])) &&
             (questions.size() < 9 || validQuestion(questions[8])) &&
             (questions.size() < 10 || validQuestion(questions[9])) &&
             (questions.size() < 11 || validQuestion(questions[10])) &&
             (questions.size() < 12 || validQuestion(questions[11])) &&
             (questions.size() < 13 || validQuestion(questions[12])) &&
             (questions.size() < 14 || validQuestion(questions[13])) &&
             (questions.size() < 15 || validQuestion(questions[14])) &&
             (questions.size() < 16 || validQuestion(questions[15])) &&
             (questions.size() < 17 || validQuestion(questions[16])) &&
             (questions.size() < 18 || validQuestion(questions[17])) &&
             (questions.size() < 19 || validQuestion(questions[18])) &&
             (questions.size() < 20 || validQuestion(questions[19])) &&
             (questions.size() < 21 || validQuestion(questions[20])) &&
             (questions.size() < 22 || validQuestion(questions[21])) &&
             (questions.size() < 23 || validQuestion(questions[22])) &&
             (questions.size() < 24 || validQuestion(questions[23])) &&
             (questions.size() < 25 || validQuestion(questions[24])) &&
             (questions.size() < 26 || validQuestion(questions[25])) &&
             (questions.size() < 27 || validQuestion(questions[26])) &&
             (questions.size() < 28 || validQuestion(questions[27])) &&
             (questions.size() < 29 || validQuestion(questions[28])) &&
             (questions.size() < 30 || validQuestion(questions[29])) &&
             (questions.size() < 31 || validQuestion(questions[30])) &&
             (questions.size() < 32 || validQuestion(questions[31])) &&
             (questions.size() < 33 || validQuestion(questions[32])) &&
             (questions.size() < 34 || validQuestion(questions[33])) &&
             (questions.size() < 35 || validQuestion(questions[34])) &&
             (questions.size() < 36 || validQuestion(questions[35])) &&
             (questions.size() < 37 || validQuestion(questions[36])) &&
             (questions.size() < 38 || validQuestion(questions[37])) &&
             (questions.size() < 39 || validQuestion(questions[38])) &&
             (questions.size() < 40 || validQuestion(questions[39])) &&
             (questions.size() < 41 || validQuestion(questions[40])) &&
             (questions.size() < 42 || validQuestion(questions[41])) &&
             (questions.size() < 43 || validQuestion(questions[42])) &&
             (questions.size() < 44 || validQuestion(questions[43])) &&
             (questions.size() < 45 || validQuestion(questions[44])) &&
             (questions.size() < 46 || validQuestion(questions[45])) &&
             (questions.size() < 47 || validQuestion(questions[46])) &&
             (questions.size() < 48 || validQuestion(questions[47])) &&
             (questions.size() < 49 || validQuestion(questions[48])) &&
             (questions.size() < 50 || validQuestion(questions[49]));
    }

    // Drafts are created empty and grow as questions are added, so the
    // question list may be empty.
    function validDraftQuestions() {
      let questions = request.resource.data.questions;
      return questions is list &&
             questions.size() <= 50 &&
             validQuestionList(questions);
    }

    // A published snapshot must always have real content.
    function validPublishedQuestions() {
      let questions = request.resource.data.questions;
      return questions is list &&
             questions.size() > 0 &&
             questions.size() <= 50 &&
             validQuestionList(questions);
    }

    function validParticipantProfile() {
      let d = request.resource.data;
      return d.keys().hasAll(['participantId', 'name', 'email', 'createdAt']) &&
             d.size() <= 6 &&
             d.participantId is string && d.participantId.size() > 0 &&
             d.name is string && d.name.size() > 0 &&
             validEmail(d.email) &&
             d.createdAt is string && d.createdAt.size() > 0 &&
             (!('institution' in d) || d.institution is string) &&
             (!('designation' in d) || d.designation is string);
    }

    // Edits may change name/institution/designation but never the identity
    // fields. The doc id is base64url(email), so the email must stay the
    // same or the profile would become unreachable.
    function validParticipantProfileUpdate() {
      let d = request.resource.data;
      let prev = resource.data;
      return validParticipantProfile() &&
             d.email == prev.email &&
             d.participantId == prev.participantId &&
             d.createdAt == prev.createdAt;
    }

    // Each write may add exactly one brand-new participant entry to a
    // question's answer document. Existing entries must never be changed or
    // removed. Map-diff rules can validate keys but cannot inspect the value
    // of an arbitrary newly added map key.
    function validAnswerWrite() {
      let prev = resource == null ? {} : resource.data;
      let delta = request.resource.data.diff(prev);
      return delta.removedKeys().size() == 0 &&
             delta.changedKeys().size() == 0 &&
             delta.addedKeys().size() == 1;
    }

    // Every published snapshot carries the full field set.
    function hasSessionShape(d) {
      return d.keys().hasAll([
        'sessionId', 'sessionName', 'description', 'sessionDate', 'status',
        'published', 'createdAt', 'updatedAt', 'publishedAt', 'publishedBy',
        'roomCode', 'shareUrl', 'qrUrl', 'questionCount', 'participantCount',
        'questions', 'presenter', 'transcriptFilename', 'analytics', 'draftId'
      ]);
    }

    function isDraft(d) {
      return d != null && d.status == 'draft';
    }

    // A draft is the editable working copy. It may be created empty and is
    // edited in place with partial (merge) writes, so only the core fields
    // are mandatory; publish-time fields are validated only when present.
    function validDraftRecord() {
      let d = request.resource.data;
      return d.status == 'draft' &&
             d.published == false &&
             d.keys().hasAll([
               'sessionId', 'sessionName', 'sessionDate', 'status',
               'published', 'createdAt', 'updatedAt', 'questionCount',
               'participantCount', 'questions'
             ]) &&
             d.sessionName is string &&
             d.sessionDate is string &&
             (!('description' in d) || d.description is string) &&
             (!('presenter' in d) || d.presenter is string) &&
             (!('transcriptFilename' in d) || d.transcriptFilename is string) &&
             (!('draftId' in d) || d.draftId is string) &&
             (!('analytics' in d) || d.analytics is map) &&
             (!('roomCode' in d) || d.roomCode is string) &&
             (!('shareUrl' in d) || d.shareUrl is string) &&
             (!('qrUrl' in d) || d.qrUrl is string) &&
             (!('publishedAt' in d) || d.publishedAt is string) &&
             (!('publishedBy' in d) || d.publishedBy is string) &&
             d.questionCount is int &&
             d.questionCount == d.questions.size() &&
             d.participantCount is int && d.participantCount >= 0 &&
             validDraftQuestions();
    }

    // The presenter flow creates a fresh immutable snapshot when publishing.
    // Firebase Authentication is not enabled in this app, so rules cannot
    // distinguish the configured presenter from another web client. Keep the
    // create gate aligned with the actual client contract and avoid rejecting
    // valid Gemini-generated question payloads on overly strict field checks.
    function validPublishedCreate() {
      let d = request.resource.data;
      return d.status == 'published' &&
             d.published == true;
    }

    // Published snapshots progress through their presenter-controlled
    // lifecycle (published -> live -> completed). As with publishing, this
    // app has no Firebase Authentication identity available to rules, so
    // avoid brittle field-by-field validation that blocks valid client writes.
    function validPublishedUpdate() {
      let d = request.resource.data;
      return d.published == true &&
             d.status in ['published', 'live', 'completed'];
    }

    // Any path not matched below is denied.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Participant registry ----
    // Participants register themselves by writing their own profile doc.
    // The doc id is base64url(email), which rules cannot recompute, so we
    // validate the shape of every write instead. Edits may update the
    // display fields (name, institution, designation) but never the
    // identity fields; deletes are denied.
    match /participants/{docId} {
      allow read: if true;
      allow create: if validParticipantProfile();
      allow update: if validParticipantProfileUpdate();
      allow delete: if false;
    }

    // ---- Sessions ----
    // Two kinds of documents live here:
    //  * draft  - the editable working copy, created and updated as a draft;
    //  * published/live/completed - immutable snapshots created fresh on every
    //    publish. Each publish writes a NEW document id; previous snapshots
    //    are never overwritten. Room History reads these snapshot documents.
    match /sessions/{sessionId} {
      allow read: if true;

      // A session doc is created either as a draft or as a published snapshot.
      allow create: if
        request.resource.data.sessionId == sessionId &&
        (validDraftRecord() || validPublishedCreate());

      // Drafts may be edited in place. Published snapshots may only move
      // through their lifecycle (published -> live -> completed) and update
      // their own participantCount/analytics.
      allow update: if
        request.resource.data.sessionId == sessionId &&
        (isDraft(resource.data) ? validDraftRecord() : validPublishedUpdate());

      // Deleting an in-progress session is not allowed.
      allow delete: if normalizeStatus(resource.data.status) != 'live';

      // ---- Per-question answers ----
      // Each participant may add exactly one new entry per question, only
      // while the session is live, and may never remove or overwrite an
      // existing entry.
      match /answers/{questionIndex} {
        allow read: if true;
        allow create, update: if
          questionIndex.matches('^[0-9]+$') &&
          isLiveSession(sessionId) &&
          validAnswerWrite();
        allow delete: if false;
      }
    }
  }
}
